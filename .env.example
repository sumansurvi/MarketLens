# MarketLens configuration. Copy to `.env` (git-ignored) and edit locally.
# Defaults run the offline demo: synthetic fixtures, deterministic fixture LLM, no voice,
# and no external network calls. Never commit real credentials.
# Don't import this file into Vercel: it holds local values. docs/DEPLOY_VERCEL.md lists the few
# variables a Vercel project needs. An empty value (NAME=) means "use the default".

# --- Core --------------------------------------------------------------------
APP_ENV=development
# demo = guaranteed offline (requires DATA_MODE=fixtures and LLM_MODE=fixture); live = allow live providers
APP_MODE=demo
# fixtures | live
DATA_MODE=fixtures
# fixture | openai
LLM_MODE=fixture
# disabled | livekit
VOICE_MODE=disabled
# Relative SQLite paths resolve against the repository root. Hosted on Vercel, use Postgres instead:
# DATABASE_URL=postgresql://… (Neon from the Vercel Marketplace sets it for you; D-98).
DATABASE_URL=sqlite:///./data/marketlens.db
FIXTURE_DIR=data/fixtures/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Browser origin allowed by backend CORS (the web app normally proxies /api same-origin).
FRONTEND_ORIGIN=http://localhost:3000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Hosted deployments only (docs/DEPLOY_VERCEL.md); leave both empty locally.
# SITE_PASSWORD: a password the browser asks for before anything loads (any user name). The web app
# checks it for pages and the backend for /api (one Vercel project, D-99), so set it once for the project.
SITE_PASSWORD=
# PROXY_SHARED_SECRET: only for a backend on its own host (D-94). When set (32+ characters, e.g.
# `openssl rand -hex 32`), the backend answers /api requests only when they carry it; the web app's
# proxy adds it. Set the same value on the web app. Not for the one-project Vercel setup, where
# browsers call /api directly. APP_ENV=production also marks the session cookie Secure (https).
PROXY_SHARED_SECRET=

# --- LLM (required only when LLM_MODE=openai; also set APP_MODE=live) ---------
OPENAI_API_KEY=
# Choose a currently supported model with structured outputs (Responses API); model IDs are
# never hardcoded. Requests are sent with store=false.
OPENAI_MODEL=
# Optional: an OpenAI-compatible endpoint instead of OpenAI. For a free local model run Ollama and set
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1 (no API key needed; OPENAI_MODEL is the pulled model name).
OPENAI_BASE_URL=
# Per model call. Calls also stop at the run deadline (RUN_TIMEOUT_SECONDS minus 5 s).
# Local models (Ollama on a laptop) need more: use 240, with RUN_TIMEOUT_SECONDS=900.
OPENAI_TIMEOUT_SECONDS=45
# A full report uses 5 calls (3 specialists, supervisor, reviewer); each may retry once.
MAX_LLM_CALLS_PER_RUN=8

# --- Market data (required only when DATA_MODE=live) -------------------------
MARKET_DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
MARKET_DATA_TIMEOUT_SECONDS=15
# Daily series, fundamentals and news cache TTL; quotes use the shorter TTL below.
MARKET_DATA_CACHE_TTL_SECONDS=900
MARKET_DATA_QUOTE_CACHE_TTL_SECONDS=60
MARKET_DATA_MAX_RETRIES=2
# Local politeness limit (1 request/second). Alpha Vantage documents 25 requests/day for free keys.
ALPHA_VANTAGE_MAX_REQUESTS_PER_MINUTE=60

# --- SEC EDGAR (required only when DATA_MODE=live) ---------------------------
# SEC fair-access policy: identify yourself with a real contact email.
SEC_USER_AGENT=MarketLens/0.1 contact=your-email@example.com
SEC_TIMEOUT_SECONDS=15
SEC_CACHE_TTL_SECONDS=3600
SEC_MAX_CONCURRENT_REQUESTS=2
# SEC allows at most 10 requests/second; stay well below it.
SEC_MAX_REQUESTS_PER_SECOND=5
SEC_DATA_BASE_URL=https://data.sec.gov
SEC_WWW_BASE_URL=https://www.sec.gov

# --- News fallback (live mode) -------------------------------------------------
# Alpha Vantage news (NEWS_SENTIMENT) is a premium endpoint. When the key's plan lacks it, the
# latest headlines come from Yahoo Finance's public per-ticker RSS feed (no key; recent headlines
# only). yahoo_rss | none
NEWS_FALLBACK=yahoo_rss
YAHOO_NEWS_BASE_URL=https://feeds.finance.yahoo.com/rss/2.0/headline

# --- LiveKit voice (optional; text research works without it) ---------------
# Needs a LiveKit Cloud project (speech and the voice model run on LiveKit Inference) and the
# voice worker: `cd services/voice_agent && uv sync && uv run marketlens-voice-agent dev`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=marketlens-voice-agent
# Voice session lifetime (token expiry and how long the worker may act for the room).
VOICE_SESSION_TTL_SECONDS=600
# Full transcripts are not stored unless enabled. Raw audio is never stored.
TRANSCRIPT_PERSISTENCE=false
# LiveKit Inference model IDs (required for voice; see https://docs.livekit.io/agents/models/).
# The LLM must support tool calling. Examples from the official agent starter (October 2026):
# VOICE_STT_MODEL=assemblyai/universal-3-6-pro  VOICE_LLM_MODEL=openai/gpt-4.1-mini (tested: calls the research
# tool reliably; the starter's google/gemma-4-31b-it sometimes only said it was checking, without calling it)
# VOICE_TTS_MODEL=fishaudio/s2.1-pro  (VOICE_TTS_VOICE takes a voice ID listed for that model)
VOICE_STT_MODEL=
VOICE_LLM_MODEL=
VOICE_TTS_MODEL=
VOICE_TTS_VOICE=
VOICE_LANGUAGE=en
# Where the voice worker reaches this backend's internal voice API.
VOICE_BACKEND_URL=http://127.0.0.1:8000

# --- How research runs execute (D-98) ------------------------------------------
# inline = a background task in the backend process (local). queue = each run is published to
# Vercel Queues and a queue-triggered function runs it (requires a Postgres DATABASE_URL; not used on
# Vercel since D-103). request = the page's own execute request runs each run; it needs a Postgres
# DATABASE_URL on Vercel. On Vercel the value is always request, whatever this says (D-101, D-103).
RUN_EXECUTION=inline
RESEARCH_QUEUE_TOPIC=marketlens-research-runs

# --- MCP and safety limits ---------------------------------------------------
# Where the MCP servers' logs go (default data/runtime/logs). - sends them to the backend's stderr.
# On Vercel it is always -, so they appear in the runtime logs (D-101). A folder that can't be
# written falls back to stderr.
MCP_LOG_DIR=
MCP_TRANSPORT=stdio
MCP_TOOL_CALL_TIMEOUT_SECONDS=20
MAX_RESEARCH_STEPS=12
MAX_PROVIDER_CALLS=20
# Local models (one Ollama): use 1, so the specialists don't queue on the model and time out.
MAX_PARALLEL_SPECIALISTS=3
MAX_REPORT_CHARS=18000
ACTION_CONFIRMATION_TTL_SECONDS=300
MAX_REQUEST_BODY_BYTES=65536
# Hard limit per research run. With LLM_MODE=openai consider 240: model steps that run out of
# time fall back to a labeled deterministic summary and the report is marked partial.
RUN_TIMEOUT_SECONDS=120

# --- Web app (read by Next.js from apps/web/.env.local or the shell) ---------
# Where the web app forwards /api/* (app/api/[...path]/route.ts), read on each request. On Vercel,
# /api goes straight to the backend service instead (D-99). The web app also reads SITE_PASSWORD
# and PROXY_SHARED_SECRET (above) from its own environment.
# BACKEND_URL=http://127.0.0.1:8000
