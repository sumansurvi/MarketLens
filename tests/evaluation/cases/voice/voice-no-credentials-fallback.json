{
  "case_id": "voice-no-credentials-fallback",
  "category": "voice",
  "kind": "steps",
  "description": "Without voice configuration, voice is clearly disabled and text research still completes.",
  "steps": [
    {
      "http": "GET /api/health",
      "expect_json": {
        "voice_enabled": false
      }
    },
    {
      "http": "POST /api/voice/session",
      "expect_status": 409,
      "expect_code": "VOICE_NOT_CONFIGURED"
    },
    {
      "http": "POST /api/research",
      "json": {
        "symbol": "AAPL",
        "question": "Research Apple over the window."
      },
      "expect_status": 202,
      "save": {
        "run": "run.run_id"
      }
    },
    {
      "wait_run": "{run}",
      "expect_status": [
        "completed"
      ]
    }
  ]
}
