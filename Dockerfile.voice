# MarketLens voice worker (optional): the LiveKit agent behind "Lens". Speech and the voice model
# run on LiveKit Cloud Inference, so this is a small always-on process with no inbound port.
# It reaches the backend's internal voice API at VOICE_BACKEND_URL. See docs/DEPLOY_VERCEL.md.
FROM python:3.13-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.24 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY services/core ./services/core
COPY services/voice_agent ./services/voice_agent
WORKDIR /app/services/voice_agent
RUN uv sync --frozen --no-dev
ENV PATH="/app/services/voice_agent/.venv/bin:$PATH" MARKETLENS_ROOT=/app
CMD ["marketlens-voice-agent", "start"]
