# MarketLens backend: FastAPI + the three MCP servers (stdio subprocesses) + SQLite.
# Long-lived processes and a database file, so it runs on a container host (Render, Railway,
# Fly.io), not on Vercel; the web app on Vercel proxies /api/* here. See docs/DEPLOY_VERCEL.md.
FROM python:3.13-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.24 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
COPY services ./services
COPY data/fixtures ./data/fixtures
RUN uv sync --frozen --no-dev --no-install-project
# MARKETLENS_ROOT: relative paths (fixtures) resolve here. The database lives on a persistent
# disk mounted at /data; without one, research history resets on every deploy or restart.
ENV PATH="/app/.venv/bin:$PATH" \
    MARKETLENS_ROOT=/app \
    APP_ENV=production \
    DATABASE_URL=sqlite:////data/marketlens.db
RUN mkdir -p /data
VOLUME /data
EXPOSE 8000
# Hosts set PORT; the health check is GET /api/health.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
